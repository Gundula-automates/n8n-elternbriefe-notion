    {
      "parameters": {
        "text": "={{ $json.text }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"termine\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": {\n      \"titel\": { \"type\": \"string\" },\n      \"datum\": { \"type\": \"string\", \"description\": \"JJJJ-MM-TT\" },\n      \"uhrzeit\": { \"type\": \"string\" } } } },\n    \"aufgaben\": { \"type\": \"array\", \"items\": { \"type\": \"object\", \"properties\": {\n      \"titel\": { \"type\": \"string\" },\n      \"frist\": { \"type\": \"string\", \"description\": \"JJJJ-MM-TT\" } } } }\n  }\n}",
        "options": {
          "systemPromptTemplate": "=Du extrahierst Termine und Aufgaben aus Elternbriefen von Schule, Kita oder Verein.\nEingangsdatum des Briefs: {{ $json.eingangsdatum }}\n\n- Datumsformat immer JJJJ-MM-TT.\n- Termin = Ereignis an einem bestimmten Tag. Aufgabe = etwas, das Eltern erledigen müssen.\n- Übernimm keine Namen von Kindern, keine Gesundheitsangaben und keine Zugangsdaten.\n- Übernimm nur, was im Text steht. Erfinde nichts.\n- Wenn nichts gefunden wird, gib leere Listen zurück.\n\n(Showcase-Version: Basis-Prompt. Der im Pilot getestete Prompt enthält weitere Regeln.)"
        }
      },
