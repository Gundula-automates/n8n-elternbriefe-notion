    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  if (item.json.text) out.push({ json: { ...item.json } });\n  for (const k of Object.keys(item.binary ?? {})) {\n    out.push({\n      json: { ...item.json, text: '', dateiname: item.binary[k].fileName },\n      binary: { datei: item.binary[k] }\n    });\n  }\n}\nreturn out;"
      },
